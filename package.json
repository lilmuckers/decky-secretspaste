{
  "name": "decky-secretspaste",
  "version": "0.1.0",
  "description": "Decky plugin that stores secrets encrypted on disk and copies them to the clipboard with an auto-wipe timer.",
  "scripts": {
    "build": "rimraf dist && cpy \"backend/**\" dist --parents && rollup -c",
    "watch": "rimraf dist && cpy \"backend/**\" dist --parents && rollup -c -w",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.22",
    "cpy-cli": "^5.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.2",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "rollup": "^4.19.0",
    "rollup-plugin-import-css": "^3.5.1",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "decky-frontend-lib": "github:SteamDeckHomebrew/decky-frontend-lib#v4.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
